APP_NAME="Ruang NOC NATWAIPI"
APP_ENV=production
VPN_PRIMARY_ONLY=true
VPN_LOCAL_ADDRESS=10.20.188.1
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Optional PEM CA bundle for RouterOS HTTPS when its certificate chain is incomplete.
ROUTEROS_CA_BUNDLE=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vpn_management
DB_USERNAME=vpn_management
DB_PASSWORD=

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_SERVER_NAME=
INITIAL_SERVER_HOST=
INITIAL_SERVER_PORT=443
INITIAL_SERVER_USERNAME=
INITIAL_SERVER_PASSWORD=
INITIAL_SERVER_PPP_PROFILE=
INITIAL_SERVER_IP_POOL=
INITIAL_SERVER_PUBLIC_IP=
INITIAL_SERVER_PORT_RANGE_START=
INITIAL_SERVER_PORT_RANGE_END=

OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

CLUSTER_SERVER_2_NAME=Router-JKT
CLUSTER_SERVER_2_HOST=
CLUSTER_SERVER_2_PORT=8433
CLUSTER_SERVER_2_PUBLIC_IP=
CLUSTER_SERVER_2_PORT_RANGE_START=1200
CLUSTER_SERVER_2_PORT_RANGE_END=2000

CLUSTER_SERVER_3_NAME=Router-Remote-JKT
CLUSTER_SERVER_3_HOST=
CLUSTER_SERVER_3_PORT=8433
CLUSTER_SERVER_3_PUBLIC_IP=
CLUSTER_SERVER_3_PORT_RANGE_START=1200
CLUSTER_SERVER_3_PORT_RANGE_END=2000

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
